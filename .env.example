# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/estateflow"

# Clerk auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Production host of the dashboard, e.g. app.estateflow.in
# (used to tell platform hostnames apart from customer custom domains)
NEXT_PUBLIC_APP_HOST=

# Vercel Domains API — required in production for custom domains
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# CNAME target customers point their domain to
DNS_CNAME_TARGET=cname.vercel-dns.com
# Same value, exposed to the browser for the setup instructions UI
NEXT_PUBLIC_DNS_CNAME_TARGET=cname.vercel-dns.com
