# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/estateflow"

# Clerk auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Production host of the dashboard, e.g. app.estateflow.in
# (used to tell platform hostnames apart from customer custom domains)
NEXT_PUBLIC_APP_HOST=

# Vercel Domains API — required in production for custom domains
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# CNAME target customers point their domain to
DNS_CNAME_TARGET=cname.vercel-dns.com
# Same value, exposed to the browser for the setup instructions UI
NEXT_PUBLIC_DNS_CNAME_TARGET=cname.vercel-dns.com

# Public URL of the app (used for links in notification emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob — image/brochure uploads.
# Created automatically when you connect a Blob store to the Vercel project;
# for local dev copy it from Vercel → Storage → your store → .env.local
BLOB_READ_WRITE_TOKEN=

# Resend — new-lead email alerts (https://resend.com/api-keys)
RESEND_API_KEY=
# Must be on a domain you verified in Resend. Leave empty to use Resend's
# test sender (only delivers to your own Resend account email).
NOTIFY_FROM_EMAIL=
